<Window x:Class="HardwareModularWorkflow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HardwareModularWorkflow.Wpf"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:r="clr-namespace:HardwareModularWorkflow.Lang;assembly=HardwareModularWorkflow.Lang"
        xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
        xmlns:views="clr-namespace:HardwareModularWorkflow.Wpf.Views"
        mc:Ignorable="d"
        Title="{I18N {x:Static r:LangKeys.Title_HardwareModularWorkflow}}" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareDefinitionViewModel}">
            <views:HardwareDefinitionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
            <views:ControllerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
            <views:ModuleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FlowViewModel}">
            <views:FlowView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExecutionLogViewModel}">
            <views:ExecutionLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar Style="{DynamicResource MaterialDesignToolBar}">
                <Button AutomationProperties.AutomationId="HomeButton"
                        Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Dashboard}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_Home}}">
                    <materialDesign:PackIcon Kind="Home" Width="20" Height="20" />
                </Button>
                <Separator />
                <Button Command="{Binding StartRuntimeCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_StartRuntime}}">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" />
                </Button>
                <Button Command="{Binding StopRuntimeCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_StopRuntime}}">
                    <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" />
                </Button>
                <Separator />
                <Button Command="{Binding RefreshHardwareCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_RefreshHardware}}">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_Settings}}">
                    <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Label_Navigation}}" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,8" />
                        
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}"
                                 Style="{StaticResource MaterialDesignNavigationListBox}"
                                 materialDesign:ListBoxAssist.IsToggle="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                   Width="24" 
                                                                   Height="24" 
                                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayTitle}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 右侧内容 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" UniformCornerRadius="8">
                    <ContentControl Content="{Binding CurrentView}" />
                </materialDesign:Card>

                <!-- 状态栏 -->
                <StatusBar Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}" />
                    <Separator />
                    <TextBlock Text="{Binding HardwareStatus}" />
                </StatusBar>
            </Grid>
        </Grid>
    </Grid>
</Window>
