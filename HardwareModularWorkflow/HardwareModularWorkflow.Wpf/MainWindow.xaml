<mah:MetroWindow x:Class="HardwareModularWorkflow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HardwareModularWorkflow.Wpf"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
        xmlns:views="clr-namespace:HardwareModularWorkflow.Wpf.Views"
        mc:Ignorable="d"
        Title="Hardware Modular Workflow" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <mah:MetroWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareDefinitionViewModel}">
            <views:HardwareDefinitionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
            <views:ControllerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
            <views:ModuleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FlowViewModel}">
            <views:FlowView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExecutionLogViewModel}">
            <views:ExecutionLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button ToolTip="Home">
                <materialDesign:PackIcon Kind="Home" Width="20" Height="20" />
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar Style="{DynamicResource MaterialDesignToolBar}">
                <Button Command="{Binding StartRuntimeCommand}" ToolTip="Start Runtime">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" />
                </Button>
                <Button Command="{Binding StopRuntimeCommand}" ToolTip="Stop Runtime">
                    <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" />
                </Button>
                <Separator />
                <Button Command="{Binding RefreshHardwareCommand}" ToolTip="Refresh Hardware">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                    <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Navigation" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,8" />
                        
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}"
                                 Style="{StaticResource MaterialDesignNavigationListBox}"
                                 materialDesign:ListBoxAssist.IsToggle="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                   Width="24" 
                                                                   Height="24" 
                                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- 右侧内容 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" UniformCornerRadius="8">
                    <ContentControl Content="{Binding CurrentView}" />
                </materialDesign:Card>

                <!-- 状态栏 -->
                <StatusBar Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}" />
                    <Separator />
                    <TextBlock Text="{Binding HardwareStatus}" />
                </StatusBar>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
