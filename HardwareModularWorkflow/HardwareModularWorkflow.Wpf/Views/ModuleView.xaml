<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.ModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="Module Editor"
                   Style="{StaticResource PageTitleStyle}" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search modules..."
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     Width="300"
                     HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadModulesCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddModuleCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" />
                        <TextBlock Text="Add Module" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：模块列表 -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource CardContainerStyle}">
                <DataGrid ItemsSource="{Binding FilteredModules}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="100" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding DefaultExecutionMode}" Width="90" />
                        <DataGridTextColumn Header="Steps" Binding="{Binding Steps.Count}" Width="60" />
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="120" />
                        <DataGridCheckBoxColumn Header="ContinueOnFail" Binding="{Binding ContinueOnFailure}" Width="110" />
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditModuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteModuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4"
                                                Foreground="Red">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- 右侧：编辑面板 -->
            <materialDesign:Card Grid.Column="1"
                                 Width="440"
                                 Margin="16,0,0,0"
                                 Padding="16">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource CardContainerStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding EditPanelTitle}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 模块基本信息 -->
                            <TextBox Text="{Binding EditModel.Name}"
                                     materialDesign:HintAssist.Hint="Module Name *"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Alias}"
                                     materialDesign:HintAssist.Hint="Alias"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Note}"
                                     materialDesign:HintAssist.Hint="Note"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Tags}"
                                     materialDesign:HintAssist.Hint="Tags (comma separated)"
                                     Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Text="{Binding EditModel.DefaultExecutionMode}"
                                          materialDesign:HintAssist.Hint="Default Execution Mode"
                                          IsEditable="False">
                                    <ComboBoxItem Content="Sequential" />
                                    <ComboBoxItem Content="Parallel" />
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Text="{Binding EditModel.TimeoutMs}"
                                         materialDesign:HintAssist.Hint="Timeout (ms)"
                                         materialDesign:TextFieldAssist.HasTrailingIcon="True"
                                         materialDesign:TextFieldAssist.TrailingIcon="Timer" />
                            </Grid>

                            <CheckBox IsChecked="{Binding EditModel.ContinueOnFailure}"
                                      Content="Continue on Failure"
                                      Margin="0,0,0,12" />

                            <!-- 分隔线 -->
                            <Separator Margin="0,0,0,12" />

                            <!-- 步骤列表标题 -->
                            <TextBlock Text="Steps"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,8" />

                            <!-- 步骤操作按钮 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding AddStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" />
                                        <TextBlock Text="Add Step" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveStepCommand}"
                                        CommandParameter="{Binding SelectedStep}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Minus" />
                                        <TextBlock Text="Remove" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MoveStepUpCommand}"
                                        CommandParameter="{Binding SelectedStep}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowUp" />
                                </Button>
                                <Button Command="{Binding MoveStepDownCommand}"
                                        CommandParameter="{Binding SelectedStep}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowDown" />
                                </Button>
                            </StackPanel>

                            <!-- 步骤列表 -->
                            <DataGrid ItemsSource="{Binding Steps}"
                                      SelectedItem="{Binding SelectedStep}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      MaxHeight="180"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="30" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100" />
                                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareInstanceId}" Width="80" />
                                    <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="90" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding ExecutionMode}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 选中步骤编辑表单 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStep}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <materialDesign:Card Padding="12" UniformCornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Edit Selected Step"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8" />

                                        <TextBox Text="{Binding SelectedStep.Name}"
                                                 materialDesign:HintAssist.Hint="Step Name *"
                                                 Margin="0,0,0,6" />

                                        <ComboBox ItemsSource="{Binding HardwareInstances}"
                                                  SelectedValue="{Binding SelectedStep.HardwareInstanceId}"
                                                  SelectedValuePath="Id"
                                                  materialDesign:HintAssist.Hint="Hardware Instance *"
                                                  Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        <TextBlock Text=" (" />
                                                        <TextBlock Text="{Binding Definition.Category.Name}" />
                                                        <TextBlock Text=")" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ComboBox ItemsSource="{Binding AvailableCommands}"
                                                  SelectedValue="{Binding SelectedStep.CommandName}"
                                                  SelectedValuePath="Name"
                                                  DisplayMemberPath="DisplayName"
                                                  materialDesign:HintAssist.Hint="Command *"
                                                  Margin="0,0,0,6" />

                                        <TextBox Text="{Binding SelectedStep.CommandParametersJson}"
                                                 materialDesign:HintAssist.Hint="Command Parameters JSON"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="60"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Margin="0,0,0,6" />

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      Text="{Binding SelectedStep.ExecutionMode}"
                                                      materialDesign:HintAssist.Hint="Execution Mode"
                                                      IsEditable="False">
                                                <ComboBoxItem Content="Sequential" />
                                                <ComboBoxItem Content="Parallel" />
                                            </ComboBox>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding SelectedStep.TimeoutMs}"
                                                     materialDesign:HintAssist.Hint="Step Timeout (ms)" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding SelectedStep.IsAsync}"
                                                      Content="Async"
                                                      Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding SelectedStep.ContinueOnFailure}"
                                                      Content="Continue on Failure" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 保存/取消 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveModuleCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Margin="0,0,4,0" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
