<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="Hardware Management" 
                   Style="{StaticResource PageTitleStyle}" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search hardware..."
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     Width="300"
                     HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadHardwareCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddHardwareCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：硬件列表 -->
            <materialDesign:Card Grid.Column="0" 
                                 Style="{StaticResource CardContainerStyle}">
                <DataGrid ItemsSource="{Binding FilteredInstances}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Definition.Type}" Width="100" />
                        <DataGridTextColumn Header="Controller" Binding="{Binding Controller.Name}" Width="120" />
                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditHardwareCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteHardwareCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4"
                                                Foreground="Red">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- 右侧：编辑面板 -->
            <materialDesign:Card Grid.Column="1"
                                 Width="350"
                                 Margin="16,0,0,0"
                                 Padding="16">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource CardContainerStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{Binding EditPanelTitle}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox Text="{Binding EditModel.Name}"
                                     materialDesign:HintAssist.Hint="Name *"
                                     Margin="0,0,0,8" />

                            <TextBox Text="{Binding EditModel.Alias}"
                                     materialDesign:HintAssist.Hint="Alias"
                                     Margin="0,0,0,8" />

                            <TextBox Text="{Binding EditModel.Note}"
                                     materialDesign:HintAssist.Hint="Note"
                                     Margin="0,0,0,8" />

                            <ComboBox ItemsSource="{Binding HardwareDefinitions}"
                                      SelectedValue="{Binding EditModel.DefinitionId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="Hardware Definition *"
                                      Margin="0,0,0,8" />

                            <TextBox Text="{Binding EditModel.Port}"
                                     materialDesign:HintAssist.Hint="Port / Channel"
                                     Margin="0,0,0,8" />

                            <TextBox Text="{Binding EditModel.Address}"
                                     materialDesign:HintAssist.Hint="Address"
                                     Margin="0,0,0,8" />

                            <ComboBox ItemsSource="{Binding Controllers}"
                                      SelectedValue="{Binding EditModel.ControllerId}"
                                      SelectedValuePath="Id"
                                      materialDesign:HintAssist.Hint="Controller"
                                      Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text=" (" />
                                            <TextBlock Text="{Binding ControllerType}" />
                                            <TextBlock Text=")" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox Text="{Binding EditModel.ParametersJson}"
                                     materialDesign:HintAssist.Hint="Parameters JSON"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="100"
                                     FontFamily="Consolas"
                                     Margin="0,0,0,8" />

                            <CheckBox IsChecked="{Binding EditModel.IsEnabled}"
                                      Content="Enabled"
                                      Margin="0,0,0,8" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveHardwareCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Margin="0,0,4,0" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
