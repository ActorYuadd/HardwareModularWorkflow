<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
    xmlns:r="clr-namespace:HardwareModularWorkflow.Lang;assembly=HardwareModularWorkflow.Lang">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{I18N {x:Static r:LangKeys.PageTitle_ExecutionMonitor}}"
                   Style="{StaticResource PageTitleStyle}" />

        <!-- 控制工具栏 -->
        <ToolBarTray Grid.Row="1" Margin="0,0,0,16">
            <ToolBar Style="{DynamicResource MaterialDesignToolBar}">
                <Button Command="{Binding StartRuntimeCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_StartRuntime}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Play" Width="20" Height="20" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Start}}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopRuntimeCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_StopRuntime}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Stop}}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelAllCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_CancelAll}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" Width="20" Height="20" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_CancelAll}}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding RefreshCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_RefreshData}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Refresh}}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearLogsCommand}" ToolTip="{I18N {x:Static r:LangKeys.Tooltip_ClearLiveLogs}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistRemove" Width="20" Height="20" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_ClearLogs}}" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：实时日志 + 硬件状态 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>

                <!-- 实时日志流 -->
                <materialDesign:Card Grid.Row="0" Style="{StaticResource CardContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static r:LangKeys.Section_LiveEventLog}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding LiveLogs}" 
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                                   FontFamily="Consolas" FontSize="11" 
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding EventType}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Message}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </materialDesign:Card>

                <!-- 硬件状态看板 -->
                <materialDesign:Card Grid.Row="2" Style="{StaticResource CardContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static r:LangKeys.Section_HardwareStatus}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HardwareItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Name}}" Binding="{Binding Name}" Width="120" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Type}}" Binding="{Binding Type}" Width="100" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Controller}}" Binding="{Binding ControllerName}" Width="120" />
                                <DataGridCheckBoxColumn Header="{I18N {x:Static r:LangKeys.Header_Enabled}}" Binding="{Binding IsEnabled}" Width="80" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Port}}" Binding="{Binding Port}" Width="80" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Address}}" Binding="{Binding Address}" Width="100" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_State}}" Binding="{Binding State}" Width="100" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Background" Value="#E8F5E9" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Background" Value="#FFEBEE" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Offline">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- 右列：执行会话 + 日志详情 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 执行会话列表 -->
                <materialDesign:Card Grid.Row="0" Style="{StaticResource CardContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static r:LangKeys.Section_RecentSessions}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSessions}"
                                  SelectedItem="{Binding SelectedSession}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Name}}" Binding="{Binding Name}" Width="120" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Started}}" 
                                                    Binding="{Binding StartedAt, StringFormat='{}{0:MM-dd HH:mm}'}" 
                                                    Width="100" />
                                <DataGridCheckBoxColumn Header="{I18N {x:Static r:LangKeys.Header_Success}}" Binding="{Binding IsSuccess}" Width="70" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_DurationMs}}" Binding="{Binding TotalDurationMs}" Width="100" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Flows}}" Binding="{Binding FlowCount}" Width="50" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Steps}}" Binding="{Binding StepCount}" Width="50" />
                                <DataGridTemplateColumn Header="{I18N {x:Static r:LangKeys.Header_Actions}}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.LoadSessionLogsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="4">
                                                <materialDesign:PackIcon Kind="FileDocument" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- 会话日志详情 -->
                <materialDesign:Card Grid.Row="2" Style="{StaticResource CardContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static r:LangKeys.Section_SessionLogs}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSessionLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Time}}" 
                                                    Binding="{Binding ExecutedAt, StringFormat='{}{0:HH:mm:ss.fff}'}" 
                                                    Width="90" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Type}}" Binding="{Binding LogType}" Width="70" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Step}}" Binding="{Binding StepName}" Width="90" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Hardware}}" Binding="{Binding HardwareName}" Width="90" />
                                <DataGridCheckBoxColumn Header="{I18N {x:Static r:LangKeys.Header_Ok}}" Binding="{Binding IsSuccess}" Width="40" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Duration}}" Binding="{Binding DurationMs}" Width="70" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Error}}" Binding="{Binding ErrorMessage}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
