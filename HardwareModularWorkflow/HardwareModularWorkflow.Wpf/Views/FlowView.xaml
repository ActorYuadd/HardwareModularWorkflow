<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
    xmlns:r="clr-namespace:HardwareModularWorkflow.Lang;assembly=HardwareModularWorkflow.Lang">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{I18N {x:Static r:LangKeys.PageTitle_WorkflowEditor}}"
                   Style="{StaticResource PageTitleStyle}" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_SearchWorkflows}}"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     Width="300"
                     HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadFlowsCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Refresh}}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddFlowCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_AddWorkflow}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：工作流列表 -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource CardContainerStyle}">
                <DataGrid ItemsSource="{Binding FilteredFlows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Name}}" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Alias}}" Binding="{Binding Alias}" Width="100" />
                        <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Mode}}" Binding="{Binding ExecutionMode}" Width="90" />
                        <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Nodes}}" 
                                            Binding="{Binding ModuleRelations.Count, StringFormat='{}{0} + '}">
                            <!-- 复合列不好绑定，用只读 -->
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="{I18N {x:Static r:LangKeys.Header_Reusable}}" Binding="{Binding IsReusable}" Width="80" />
                        <DataGridCheckBoxColumn Header="{I18N {x:Static r:LangKeys.Header_ContinueOnFail}}" Binding="{Binding ContinueOnFailure}" Width="110" />
                        <DataGridTemplateColumn Header="{I18N {x:Static r:LangKeys.Header_Actions}}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4"
                                                Foreground="Red">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- 右侧：编辑面板 -->
            <materialDesign:Card Grid.Column="1"
                                 Width="460"
                                 Margin="16,0,0,0"
                                 Padding="16">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource CardContainerStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding EditPanelTitle}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 工作流基本信息 -->
                            <TextBox Text="{Binding EditModel.Name}"
                                     materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_WorkflowNameRequired}}"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Alias}"
                                     materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_Alias}}"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Note}"
                                     materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_Note}}"
                                     Margin="0,0,0,6" />

                            <TextBox Text="{Binding EditModel.Tags}"
                                     materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_TagsCommaSeparated}}"
                                     Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Text="{Binding EditModel.ExecutionMode}"
                                          materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_ExecutionMode}}"
                                          IsEditable="False">
                                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.ComboBoxItem_Sequential}}" />
                                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.ComboBoxItem_Parallel}}" />
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Text="{Binding EditModel.TimeoutMs}"
                                         materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_TimeoutMs}}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding EditModel.IsReusable}"
                                          Content="{I18N {x:Static r:LangKeys.CheckBox_Reusable}}"
                                          Margin="0,0,12,0" />
                                <CheckBox IsChecked="{Binding EditModel.ContinueOnFailure}"
                                          Content="{I18N {x:Static r:LangKeys.CheckBox_ContinueOnFailure}}" />
                            </StackPanel>

                            <!-- 循环检测警告 -->
                            <TextBlock Text="{Binding CycleWarning}"
                                       Foreground="Red"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CycleWarning}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 分隔线 -->
                            <Separator Margin="0,0,0,12" />

                            <!-- 节点列表标题 -->
                            <TextBlock Text="{I18N {x:Static r:LangKeys.Section_FlowNodes}}"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,8" />

                            <!-- 添加模块/子流 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Row="0" Grid.Column="0"
                                          ItemsSource="{Binding AvailableModules}"
                                          SelectedItem="{Binding SelectedModuleToAdd}"
                                          materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_SelectModuleToAdd}}"
                                          Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="Bold">
                                                    <TextBlock.Text>
                                                        <I18N Key="{x:Static r:LangKeys.Format_ModuleItem}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="Definition.Type" />
                                                            <Binding Path="Steps.Count" />
                                                        </I18N>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Row="0" Grid.Column="1"
                                        Command="{Binding AddModuleNodeCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" />
                                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_AddModule}}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          ItemsSource="{Binding AvailableSubFlows}"
                                          SelectedItem="{Binding SelectedSubFlowToAdd}"
                                          materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_SelectSubFlowToAdd}}"
                                          Margin="0,4,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="Bold">
                                                    <TextBlock.Text>
                                                        <I18N Key="{x:Static r:LangKeys.Format_NameWithDetail}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="ExecutionMode" />
                                                        </I18N>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Row="1" Grid.Column="1"
                                        Command="{Binding AddSubFlowNodeCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" />
                                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_AddSubFlow}}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 节点操作按钮 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding RemoveNodeCommand}"
                                        CommandParameter="{Binding SelectedFlowNode}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Minus" />
                                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Remove}}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MoveNodeUpCommand}"
                                        CommandParameter="{Binding SelectedFlowNode}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowUp" />
                                </Button>
                                <Button Command="{Binding MoveNodeDownCommand}"
                                        CommandParameter="{Binding SelectedFlowNode}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowDown" />
                                </Button>
                            </StackPanel>

                            <!-- 节点列表 -->
                            <DataGrid ItemsSource="{Binding FlowNodes}"
                                      SelectedItem="{Binding SelectedFlowNode}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      MaxHeight="160"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Number}}" Binding="{Binding OrderIndex}" Width="30" />
                                    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Name}}" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Type}}" Binding="{Binding NodeType}" Width="70" />
                                    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Header_Mode}}" Binding="{Binding ExecutionMode}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 选中节点编辑表单 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFlowNode}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <materialDesign:Card Padding="12" UniformCornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{I18N {x:Static r:LangKeys.Section_EditSelectedNode}}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding SelectedFlowNode.Name, StringFormat='Name: {0}'}"
                                                   Margin="0,0,0,6" />

                                        <TextBlock Text="{Binding SelectedFlowNode.NodeType, StringFormat='Type: {0}'}"
                                                   Margin="0,0,0,6" />

                                        <ComboBox Text="{Binding SelectedFlowNode.ExecutionMode}"
                                                  materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_ExecutionMode}}"
                                                  IsEditable="False"
                                                  Margin="0,0,0,6">
                                            <ComboBoxItem Content="{I18N {x:Static r:LangKeys.ComboBoxItem_Sequential}}" />
                                            <ComboBoxItem Content="{I18N {x:Static r:LangKeys.ComboBoxItem_Parallel}}" />
                                        </ComboBox>

                                        <TextBox Text="{Binding SelectedFlowNode.Condition}"
                                                 materialDesign:HintAssist.Hint="{I18N {x:Static r:LangKeys.Hint_Condition}}"
                                                 Margin="0,0,0,6" />
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 保存/取消 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveFlowCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Save}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Margin="0,0,4,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Cancel}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
