<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 操作按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0" />
                    <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                            CornerRadius="12" Padding="8,2" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Unsaved" Foreground="White" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Margin="0,0,4,0" />
                            <TextBlock Text="Reset" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadSettingsCommand}" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Margin="0,0,4,0" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="1" 
                    CornerRadius="6" 
                    Padding="10,6"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDirty}" Value="False">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Kind" Value="AlertCircle" />
                                        <Setter Property="Foreground" Value="#FF9800" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="False">
                                        <Setter Property="Kind" Value="CheckCircle" />
                                        <Setter Property="Foreground" Value="#4CAF50" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Foreground" Value="#E65100" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="False">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 设置内容区域 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Grid.Column="0">
                    <!-- 通用设置 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="General"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,16" />

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="Translate" Width="24" Height="24"
                                                     Margin="0,0,12,12" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Language" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding Language}"
                                          materialDesign:HintAssist.Hint="Select language"
                                          MinWidth="150" HorizontalAlignment="Left" />
                            </StackPanel>

                            <materialDesign:PackIcon Grid.Row="2" Grid.Column="0"
                                                     Kind="ThemeLightDark" Width="24" Height="24"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Dark Theme" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <ToggleButton IsChecked="{Binding DarkTheme}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- 数据库设置 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="Database"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,16" />

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="Database" Width="24" Height="24"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="SQLite database file path"
                                     VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Command="{Binding BrowseDatabasePathCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="8,0,0,0" Padding="8,4">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- 调度器设置 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="Scheduler"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,16" />

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="Schedule" Width="24" Height="24"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="#FF9800" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Max Concurrent Slots: {0}">
                                            <Binding Path="SchedulerMaxSlots" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Slider Minimum="1" Maximum="200"
                                        Value="{Binding SchedulerMaxSlots}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </StackPanel>

                <!-- 右列 -->
                <StackPanel Grid.Column="2">
                    <!-- 日志设置 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="Logs"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,16" />

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="History" Width="24" Height="24"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="#9C27B0" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Log Retention (days): {0}">
                                            <Binding Path="LogRetentionDays" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Slider Minimum="1" Maximum="365"
                                        Value="{Binding LogRetentionDays}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- DLL 路径设置 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="DLL Paths"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,16" />

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="CogBox" Width="24" Height="24"
                                                     Margin="0,0,12,12" VerticalAlignment="Center"
                                                     Foreground="#E53935" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding PlcDllPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="PLC DLL path (e.g., EPAN.dll)"
                                     VerticalAlignment="Center" Margin="0,0,0,12" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Command="{Binding BrowsePlcDllPathCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="8,0,0,12" Padding="8,4">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" />
                            </Button>

                            <materialDesign:PackIcon Grid.Row="2" Grid.Column="0"
                                                     Kind="Usb" Width="24" Height="24"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Foreground="#1E88E5" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding CanDllPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="CAN DLL path (e.g., zlgcan.dll)"
                                     VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="2"
                                    Command="{Binding BrowseCanDllPathCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="8,0,0,0" Padding="8,4">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- 说明卡片 -->
                    <materialDesign:Card Style="{StaticResource CardContainerStyle}">
                        <StackPanel>
                            <TextBlock Text="About"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Hardware Modular Workflow"
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                            <TextBlock Text="A hardware-centric modular workflow automation platform."
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationCircle" Width="16" Height="16"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings are saved to app_settings.json in the application directory."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
