<UserControl x:Class="HardwareModularWorkflow.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareModularWorkflow.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
    xmlns:r="clr-namespace:HardwareModularWorkflow.Lang;assembly=HardwareModularWorkflow.Lang">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 刷新 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{I18N {x:Static r:LangKeys.PageTitle_Dashboard}}" Style="{StaticResource PageTitleStyle}" Margin="0" />
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Button_Refresh}}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 运行时状态指示条 -->
            <Border Grid.Row="1" 
                    CornerRadius="8" 
                    Padding="12,8"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="False">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Circle" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="False">
                                        <Setter Property="Foreground" Value="#F44336" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="True">
                                        <Setter Property="Text" Value="Runtime is running" />
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRuntimeRunning}" Value="False">
                                        <Setter Property="Text" Value="Runtime is stopped" />
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.6" />
                </StackPanel>
            </Border>

            <!-- 统计卡片行 -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 硬件统计 -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Chip" Width="28" Height="28" 
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="{I18N {x:Static r:LangKeys.CardTitle_Hardware}}" Margin="8,0,0,0" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalHardwareCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MotorCount, StringFormat='Motor: {0}'}" FontSize="11" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TemperatureCount, StringFormat='Temp: {0}'}" FontSize="11" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CoolingCount, StringFormat='Cool: {0}'}" FontSize="11" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomCount, StringFormat='Custom: {0}'}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 控制器统计 -->
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="LanConnect" Width="28" Height="28" 
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}" />
                            <TextBlock Text="{I18N {x:Static r:LangKeys.CardTitle_Controllers}}" Margin="8,0,0,0" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalControllerCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PlcCount, StringFormat='PLC: {0}'}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding CanCount, StringFormat='CAN: {0}'}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 今日执行统计 -->
                <materialDesign:Card Grid.Column="4" UniformCornerRadius="8" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="LightningBolt" Width="28" Height="28" 
                                                     Foreground="#FF9800" />
                            <TextBlock Text="{I18N {x:Static r:LangKeys.CardTitle_Today}}" Margin="8,0,0,0" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodaySessionCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="#FF9800" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TodaySuccessCount, StringFormat='Success: {0}'}" FontSize="11" 
                                       Foreground="#4CAF50" />
                            <TextBlock Grid.Column="1" Text="{Binding TodayFailedCount, StringFormat='Failed: {0}'}" FontSize="11" 
                                       Foreground="#F44336" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 工作流统计 -->
                <materialDesign:Card Grid.Column="6" UniformCornerRadius="8" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="SourceFork" Width="28" Height="28" 
                                                     Foreground="#9C27B0" />
                            <TextBlock Text="{I18N {x:Static r:LangKeys.CardTitle_Workflows}}" Margin="8,0,0,0" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalFlowCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="#9C27B0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ReusableFlowCount, StringFormat='Reusable: {0}'}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- 下方区域：实时日志 + 快捷入口 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 实时日志预览 -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static r:LangKeys.Section_RecentEvents}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding RecentEvents}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                                   FontFamily="Consolas" FontSize="11" 
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding EventType}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Message}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </materialDesign:Card>

                <!-- 快捷入口 -->
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Section_QuickAccess}}" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,12" />
                        <Button AutomationProperties.AutomationId="QuickAccessHardwareButton"
                                Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Hardware}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Chip" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.CardTitle_Hardware}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="QuickAccessControllerButton"
                                Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Controller}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanConnect" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_NavigateController}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="QuickAccessModuleButton"
                                Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Module}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewModule" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_NavigateModule}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="QuickAccessWorkflowButton"
                                Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Workflow}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SourceFork" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_NavigateWorkflow}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="QuickAccessMonitorButton"
                                Command="{Binding NavigateToCommand}" CommandParameter="{x:Static r:LangKeys.Navigation_Monitor}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Monitor" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Button_NavigateMonitor}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
