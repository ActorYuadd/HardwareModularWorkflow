<UserControl x:Class="HardwareModularWorkflow.Wpf.Controls.WorkflowGraphEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HardwareModularWorkflow.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}"
             x:Name="GraphRoot">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- 节点类型图标映射 -->
        <Style x:Key="NodeBaseStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 节点模板选择器基于类型 -->
        <DataTemplate x:Key="StartNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#E8F5E9" BorderBrush="#4CAF50">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlayCircle" Foreground="#4CAF50" Width="20" Height="20" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EndNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#FFEBEE" BorderBrush="#F44336">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="StopCircle" Foreground="#F44336" Width="20" Height="20" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SwitchNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#FFF3E0" BorderBrush="#FF9800">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CallSplit" Foreground="#FF9800" Width="20" Height="20" Margin="0,0,4,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding RouteKeyVariable, StringFormat='RouteKey: {0}'}" FontSize="10" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ModuleNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#E3F2FD" BorderBrush="#2196F3">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewModule" Foreground="#2196F3" Width="20" Height="20" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SubFlowNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#F3E5F5" BorderBrush="#9C27B0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="SourceFork" Foreground="#9C27B0" Width="20" Height="20" Margin="0,0,4,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding InvocationPolicy, StringFormat='策略: {0}'}" FontSize="10" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ForkNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#E0F2F1" BorderBrush="#009688">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="GitFork" Foreground="#009688" Width="20" Height="20" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="JoinNodeTemplate">
            <Border Style="{StaticResource NodeBaseStyle}" Background="#ECEFF1" BorderBrush="#607D8B">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CallMerge" Foreground="#607D8B" Width="20" Height="20" Margin="0,0,4,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding JoinMode, StringFormat='模式: {0}'}" FontSize="10" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 节点模板选择器 -->
        <local:GraphNodeTemplateSelector x:Key="NodeTemplateSelector"
            StartTemplate="{StaticResource StartNodeTemplate}"
            EndTemplate="{StaticResource EndNodeTemplate}"
            SwitchTemplate="{StaticResource SwitchNodeTemplate}"
            ModuleTemplate="{StaticResource ModuleNodeTemplate}"
            SubFlowTemplate="{StaticResource SubFlowNodeTemplate}"
            ForkTemplate="{StaticResource ForkNodeTemplate}"
            JoinTemplate="{StaticResource JoinNodeTemplate}" />
    </UserControl.Resources>

    <!-- 主容器：支持鼠标事件 -->
    <Grid MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp" MouseWheel="OnCanvasMouseWheel">
        <!-- 缩放和平移容器 -->
        <Grid x:Name="TransformGrid" RenderTransform="{Binding ElementName=GraphRoot, Path=CanvasTransform}">
            <!-- 边线层 -->
            <ItemsControl ItemsSource="{Binding ElementName=GraphRoot, Path=Edges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              StrokeThickness="{Binding StrokeThickness}"
                              StrokeDashArray="{Binding StrokeDashArray}">
                            <Line.Stroke>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <local:EdgeColorConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="IsExecuted" />
                                    <Binding Path="RouteKey" />
                                </MultiBinding>
                            </Line.Stroke>
                        </Line>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 节点层 -->
            <ItemsControl ItemsSource="{Binding ElementName=GraphRoot, Path=Nodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Width" Value="{Binding Width}" />
                        <Setter Property="Height" Value="{Binding Height}" />
                        <EventSetter Event="MouseDown" Handler="OnNodeMouseDown" />
                        <EventSetter Event="MouseMove" Handler="OnNodeMouseMove" />
                        <EventSetter Event="MouseUp" Handler="OnNodeMouseUp" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplateSelector>
                    <local:GraphNodeTemplateSelector x:Name="InternalNodeSelector"
                        StartTemplate="{StaticResource StartNodeTemplate}"
                        EndTemplate="{StaticResource EndNodeTemplate}"
                        SwitchTemplate="{StaticResource SwitchNodeTemplate}"
                        ModuleTemplate="{StaticResource ModuleNodeTemplate}"
                        SubFlowTemplate="{StaticResource SubFlowNodeTemplate}"
                        ForkTemplate="{StaticResource ForkNodeTemplate}"
                        JoinTemplate="{StaticResource JoinNodeTemplate}" />
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>
        </Grid>

        <!-- 缩略提示：缩放比例 -->
        <TextBlock x:Name="ZoomLevelLabel" Text="100%"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="8" FontSize="11" Opacity="0.5" />

        <!-- 连接模式提示 -->
        <Border Background="#00000088" CornerRadius="4" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Visibility="{Binding ElementName=GraphRoot, Path=ConnectionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="连接模式：点击源节点，再点击目标节点" Foreground="White" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
