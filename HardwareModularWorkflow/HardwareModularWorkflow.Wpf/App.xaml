<Application x:Class="HardwareModularWorkflow.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HardwareModularWorkflow.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="DeepPurple"
                                 SecondaryColor="Purple">
                    <md:BundledTheme.ColorAdjustment>
                        <md:ColorAdjustment Colors="All"
                                            Contrast="Medium"
                                            DesiredContrastRatio="4.0" />
                    </md:BundledTheme.ColorAdjustment>
                </md:BundledTheme>
                
                <!-- MaterialDesign -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                
                <!-- App specific resources -->
                <ResourceDictionary Source="Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
